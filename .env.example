# Copy this file to .env.local for local development.
# Placeholder values only. Never commit real credentials or secrets.

# Public site URL (placeholder).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# PostgreSQL connection (SERVER-ONLY). Use the dedicated application role.
# In production this is the Neon pooled connection string (it normally ends
# with ?sslmode=require). Never commit it and never print it in logs.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Optional Prisma/pg connection-pool limit (SERVER-ONLY). Leave unset to use
# the driver default. Serverless hosts usually need a small value or the Neon
# pooled endpoint; the application caches one Prisma client per process.
# DATABASE_POOL_MAX=""

# Product image storage (SERVER-ONLY). When set, product uploads use Vercel
# Blob. When unset, local development keeps writing under
# public/images/products/uploads/ and production uploads fail with a clear
# setup message. Create the Blob store in the Vercel project and let Vercel
# inject this value; never paste it into chat or commit it.
# BLOB_READ_WRITE_TOKEN=""

# Approved payment details are SERVER-ONLY.
# Never prefix these names with NEXT_PUBLIC_ and never commit real values.
# The approved methods are Bank Transfer (Islamic Bank) and Easypaisa.
# A method stays unavailable at checkout until both its account number and
# account holder are configured. PAYMENT_BANK_DISPLAY_NAME is optional; when
# absent the approved name "Islamic Bank" is used.
# PAYMENT_BANK_DISPLAY_NAME="Islamic Bank"
# PAYMENT_BANK_ACCOUNT_NUMBER=""
# PAYMENT_BANK_ACCOUNT_HOLDER=""
# PAYMENT_EASYPAISA_NUMBER=""
# PAYMENT_EASYPAISA_ACCOUNT_HOLDER=""

# Checkout review draft signing secret (SERVER-ONLY).
# Optional in development; a per-process random secret is used if absent.
# Set a long random value in production.
# CHECKOUT_DRAFT_SECRET=""

# Administrator multi-factor authentication (SERVER-ONLY).
# REQUIRED in production. Generate 32 random bytes and encode them as base64
# or 64 hex characters, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOTP secrets are encrypted at rest with AES-256-GCM under this key. Losing or
# rotating the key without re-enrolling every administrator makes existing
# authenticators unreadable. Never commit or share it.
# ADMIN_MFA_ENCRYPTION_KEY=""

# Optional dedicated signing secret for the five-minute MFA challenge cookie.
# When unset, CHECKOUT_DRAFT_SECRET is used. Set a separate 32+ character value
# in production if you want independent rotation.
# ADMIN_MFA_CHALLENGE_SECRET=""

# Development-only switch to exercise MFA locally. Production always enforces
# MFA regardless of this value. Do not set it in production.
# ADMIN_MFA_REQUIRED="true"

# Shared rate limiting (SERVER-ONLY).
# Production must use "upstash" so every server instance shares the buckets.
# "memory" is allowed in development and tests; production refuses it unless
# RATE_LIMIT_ALLOW_MEMORY_IN_PRODUCTION="true" is set deliberately.
# RATE_LIMIT_PROVIDER="upstash"
# UPSTASH_REDIS_REST_URL="https://YOUR-ENDPOINT.upstash.io"
# UPSTASH_REDIS_REST_TOKEN=""
# RATE_LIMIT_ALLOW_MEMORY_IN_PRODUCTION="false"

# One-time first administrator setup (SERVER-ONLY, WEBSITE-OWNER ACTION).
# The website owner (client) sets this during handover and creates the first
# Super Admin at /admin/setup. The developer must not create an administrator
# account. Used only while no administrator account exists. Once the first
# Super Admin exists, setup is permanently disabled. Never prefix with
# NEXT_PUBLIC_, never commit a real value, and never share it in logs or chat.
# Remove it after setup completes.
#
# Generate a long random secret locally, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ADMIN_SETUP_SECRET=""

# Break-glass administrator bootstrap script (SERVER-ONLY, OWNER-RUN RECOVERY).
# Not the normal handover path. Only the website owner or an explicitly
# authorized operator should run:
#   node scripts/bootstrap-admin.mjs
# It reads credentials from the environment, hashes the password, and never
# prints the password. No default credentials exist. Delete these values after
# the account is created.
# ADMIN_BOOTSTRAP_EMAIL=""
# ADMIN_BOOTSTRAP_PASSWORD=""
